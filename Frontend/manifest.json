{
  "manifest_version": 3,
  "name": "TrustMeter",
  "short_name": "TrustMeter",
  "description": "Understand any site's privacy & terms in 8 points, before you sign up.",
  "version": "1.0.0",
  "version_name": "1.0.0",
  "author": "Rohit Nain",
  "homepage_url": "https://github.com/rohit141914/TrustMeter",
  "permissions": ["storage", "activeTab"],
  "host_permissions": ["<all_urls>"],
  "icons": {
    "16": "src/images/icon.png",
    "48": "src/images/icon.png",
    "128": "src/images/icon.png"
  },
  "action": {
    "default_popup": "index.html",
    "default_title": "TrustMeter",
    "default_icon": {
      "16": "src/images/icon.png",
      "48": "src/images/icon.png",
      "128": "src/images/icon.png"
    }
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/overlay.jsx"],
      "run_at": "document_idle"
    }
  ]
}
